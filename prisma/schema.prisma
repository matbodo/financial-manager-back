generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  Int             @id @default(autoincrement())
  name                String?         @db.VarChar(100)
  email               String?         @unique(map: "email") @db.VarChar(100)
  password            String?         @db.VarChar(255)
  createdAt           DateTime?       @default(now()) @map("created_at") @db.Timestamp(0)
  income              Decimal?        @default(0.00) @db.Decimal(10, 2)
  resetToken          String?         @db.VarChar(255)
  resetTokenExpires   DateTime?       @db.Timestamp(0)

  signatures          Signature[]
  expenses            Expense[]
  investments         Investment[]
  categories          Category[]
  budgets             Budget[]
  refresh_tokens      RefreshToken[]

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.VarChar(36)
  token      String    @unique(map: "token") @db.VarChar(500)
  user_id    Int
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(0)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  usuarios   User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_ibfk_1")

  @@index([user_id], map: "refresh_tokens_user_id_idx")
  @@map("refresh_tokens")
}

model Signature {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  value       Decimal   @db.Decimal(10, 2)
  user_id     Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  billing_day Int?
  usuarios    User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "signatures_ibfk_1")
  
  category_id Int?
  category    Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "user_id")
}

model Expense {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  value       Decimal   @db.Decimal(10, 2)
  user_id     Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  usuarios    User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_ibfk_1")

  category_id Int?
  category    Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "user_id")
}

model Investment {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  value      Decimal    @db.Decimal(10, 2)
  user_id    Int  
  created_at DateTime?  @default(now()) @db.Timestamp(0)
  date       DateTime?  @db.Date
  usuarios   User       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "investments_ibfk_1")
  
  category_id Int?
  category    Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([user_id], map: "user_id")
}

model Category {
  id            Int       @id @default(autoincrement())
  name          String
  color         String?
  icon          String?
  user_id       Int
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at    DateTime  @default(now())

  expenses      Expense[]
  signatures    Signature[]
  investments   Investment[]
  budgets       Budget[]

  @@map("categories")
}

model Budget {
  id          Int       @id @default(autoincrement())
  amount      Decimal   @db.Decimal(10, 2)
  month       Int
  year        Int
  user_id     Int
  category_id Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)

  user      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category  Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month, year])
  @@index([user_id], map: "user_id_budgets")
  @@map("budgets")
}