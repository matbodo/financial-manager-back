generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int             @id @default(autoincrement())
  name          String?         @db.VarChar(100)
  email         String?         @unique(map: "email") @db.VarChar(100)
  password      String?         @db.VarChar(255)
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(0)
  income        Decimal?        @default(0.00) @db.Decimal(10, 2)
  assinaturas   assinaturas[]
  gastos        gastos[]
  investimentos investimentos[]

  @@map("usuarios")
}

model assinaturas {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  value       Decimal   @db.Decimal(10, 2)
  user_id     Int
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  billing_day Int?
  usuarios    User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "assinaturas_ibfk_1")

  @@index([user_id], map: "user_id")
}

model gastos {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  value      Decimal   @db.Decimal(10, 2)
  user_id    Int
  created_at DateTime? @default(now()) @db.Timestamp(0)
  usuarios   User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "gastos_ibfk_1")

  @@index([user_id], map: "user_id")
}

model investimentos {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  value      Decimal   @db.Decimal(10, 2)
  user_id    Int
  created_at DateTime? @default(now()) @db.Timestamp(0)
  date       DateTime? @db.Date
  usuarios   User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "investimentos_ibfk_1")

  @@index([user_id], map: "user_id")
}
